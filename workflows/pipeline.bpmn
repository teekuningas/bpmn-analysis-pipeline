<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:spiff="http://spiffworkflow.org/bpmn/schema/1.0/core"
                  id="Definitions_Pipeline"
                  targetNamespace="https://github.com/teekuningas/bpmn-analysis-pipeline">

  <bpmn:process id="Process_Pipeline" name="Themes and context" isExecutable="true">

    <bpmn:property id="drafts" name="drafts"/>
    <bpmn:property id="vectors" name="vectors"/>
    <bpmn:property id="labels" name="labels"/>
    <bpmn:property id="rows" name="rows"/>

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:parallelGateway id="Fork">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f_ctx</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="ReadDocuments" name="Read">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="read" resultVariable="documents">
          <spiff:parameters>
            <spiff:parameter id="source" value="&apos;interview accounts&apos;"/>
            <spiff:parameter id="count" value="4"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:subProcess id="PerDocument" name="For each account">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:property id="passes" name="passes"/>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>documents.count</bpmn:loopCardinality>
        <bpmn:loopDataOutputRef>drafts</bpmn:loopDataOutputRef>
        <bpmn:outputDataItem name="passes"/>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartDocument"><bpmn:outgoing>d1</bpmn:outgoing></bpmn:startEvent>

      <bpmn:subProcess id="PerPass" name="For each pass">
        <bpmn:incoming>d1</bpmn:incoming>
        <bpmn:outgoing>d2</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:loopCardinality>2</bpmn:loopCardinality>
          <bpmn:loopDataOutputRef>passes</bpmn:loopDataOutputRef>
          <bpmn:outputDataItem name="records"/>
        </bpmn:multiInstanceLoopCharacteristics>

        <bpmn:startEvent id="StartPass"><bpmn:outgoing>p1</bpmn:outgoing></bpmn:startEvent>

        <bpmn:serviceTask id="Draft" name="Generate">
          <bpmn:extensionElements>
            <spiff:serviceTaskOperator id="generate" resultVariable="draft">
              <spiff:parameters>
                <spiff:parameter id="prompt" value="&apos;Read this account and name the themes in it&apos;"/>
                <spiff:parameter id="of" value="documents"/>
                <spiff:parameter id="fails" value="0.15"/>
              </spiff:parameters>
            </spiff:serviceTaskOperator>
          </bpmn:extensionElements>
          <bpmn:incoming>p1</bpmn:incoming>
          <bpmn:incoming>p_retry</bpmn:incoming>
          <bpmn:outgoing>p2</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:boundaryEvent id="DraftFailed" attachedToRef="Draft">
          <bpmn:errorEventDefinition/>
          <bpmn:outgoing>p_backoff</bpmn:outgoing>
        </bpmn:boundaryEvent>

        <bpmn:intermediateCatchEvent id="BackOff">
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration>PT0.5S</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
          <bpmn:incoming>p_backoff</bpmn:incoming>
          <bpmn:outgoing>p_retry</bpmn:outgoing>
        </bpmn:intermediateCatchEvent>

        <bpmn:serviceTask id="Structure" name="Generate">
          <bpmn:extensionElements>
            <spiff:serviceTaskOperator id="generate" resultVariable="records">
              <spiff:parameters>
                <spiff:parameter id="prompt" value="&apos;Write each theme you named as one short label&apos;"/>
                <spiff:parameter id="of" value="draft"/>
                <spiff:parameter id="count" value="3"/>
              </spiff:parameters>
            </spiff:serviceTaskOperator>
          </bpmn:extensionElements>
          <bpmn:incoming>p2</bpmn:incoming>
          <bpmn:outgoing>p3</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:endEvent id="EndPass"><bpmn:incoming>p3</bpmn:incoming></bpmn:endEvent>

        <bpmn:sequenceFlow id="p1" sourceRef="StartPass" targetRef="Draft"/>
        <bpmn:sequenceFlow id="p_backoff" sourceRef="DraftFailed" targetRef="BackOff"/>
        <bpmn:sequenceFlow id="p_retry" sourceRef="BackOff" targetRef="Draft"/>
        <bpmn:sequenceFlow id="p2" sourceRef="Draft" targetRef="Structure"/>
        <bpmn:sequenceFlow id="p3" sourceRef="Structure" targetRef="EndPass"/>
      </bpmn:subProcess>

      <bpmn:endEvent id="EndDocument"><bpmn:incoming>d2</bpmn:incoming></bpmn:endEvent>

      <bpmn:sequenceFlow id="d1" sourceRef="StartDocument" targetRef="PerPass"/>
      <bpmn:sequenceFlow id="d2" sourceRef="PerPass" targetRef="EndDocument"/>
    </bpmn:subProcess>

    <bpmn:serviceTask id="Pool" name="Combine">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="combine" resultVariable="pooled">
          <spiff:parameters>
            <spiff:parameter id="how" value="&apos;every label from every pass&apos;"/>
            <spiff:parameter id="parts" value="drafts"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="EmbedEach" name="Embed">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="embed" resultVariable="vector">
          <spiff:parameters>
            <spiff:parameter id="model" value="&apos;multilingual sentences&apos;"/>
            <spiff:parameter id="of" value="pooled"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>pooled.count</bpmn:loopCardinality>
        <bpmn:loopDataOutputRef>vectors</bpmn:loopDataOutputRef>
        <bpmn:outputDataItem name="vector"/>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>

    <bpmn:subProcess id="Refine" name="Refine">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics loopMaximum="2"/>

      <bpmn:startEvent id="StartRefine"><bpmn:outgoing>r0</bpmn:outgoing></bpmn:startEvent>

      <bpmn:serviceTask id="Similarity" name="Compare">
        <bpmn:extensionElements>
          <spiff:serviceTaskOperator id="compare" resultVariable="similarity">
            <spiff:parameters>
              <spiff:parameter id="metric" value="&apos;cosine distance&apos;"/>
              <spiff:parameter id="of" value="vectors"/>
            </spiff:parameters>
          </spiff:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>r0</bpmn:incoming>
        <bpmn:outgoing>r1</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:userTask id="Threshold" name="Decide">
        <bpmn:extensionElements>
          <spiff:serviceTaskOperator id="decide" resultVariable="threshold">
            <spiff:parameters>
              <spiff:parameter id="question" value="&apos;How similar counts as the same?&apos;"/>
              <spiff:parameter id="of" value="similarity"/>
            </spiff:parameters>
          </spiff:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>r1</bpmn:incoming>
        <bpmn:outgoing>r2</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:serviceTask id="Cluster" name="Group">
        <bpmn:extensionElements>
          <spiff:serviceTaskOperator id="group" resultVariable="groups">
            <spiff:parameters>
              <spiff:parameter id="by" value="&apos;distance below the threshold&apos;"/>
              <spiff:parameter id="of" value="similarity"/>
              <spiff:parameter id="threshold" value="threshold"/>
              <spiff:parameter id="count" value="4"/>
            </spiff:parameters>
          </spiff:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>r2</bpmn:incoming>
        <bpmn:outgoing>r3</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:endEvent id="EndRefine"><bpmn:incoming>r3</bpmn:incoming></bpmn:endEvent>

      <bpmn:sequenceFlow id="r0" sourceRef="StartRefine" targetRef="Similarity"/>
      <bpmn:sequenceFlow id="r1" sourceRef="Similarity" targetRef="Threshold"/>
      <bpmn:sequenceFlow id="r2" sourceRef="Threshold" targetRef="Cluster"/>
      <bpmn:sequenceFlow id="r3" sourceRef="Cluster" targetRef="EndRefine"/>
    </bpmn:subProcess>

    <bpmn:serviceTask id="NameGroups" name="Generate">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="generate" resultVariable="label">
          <spiff:parameters>
            <spiff:parameter id="prompt" value="&apos;Give this group of labels one shared name&apos;"/>
            <spiff:parameter id="of" value="groups"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>groups.count</bpmn:loopCardinality>
        <bpmn:loopDataOutputRef>labels</bpmn:loopDataOutputRef>
        <bpmn:outputDataItem name="label"/>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ReadContext" name="Read">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="read" resultVariable="context">
          <spiff:parameters>
            <spiff:parameter id="source" value="&apos;land cover at each site&apos;"/>
            <spiff:parameter id="count" value="4"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f_ctx</bpmn:incoming>
      <bpmn:outgoing>f_ctx2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Merge">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f_ctx2</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Subset" name="Select">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="select" resultVariable="subset">
          <spiff:parameters>
            <spiff:parameter id="where" value="&apos;one account per participant&apos;"/>
            <spiff:parameter id="of" value="documents"/>
            <spiff:parameter id="count" value="3"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>c2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:subProcess id="PerScored" name="For each account">
      <bpmn:incoming>c2</bpmn:incoming>
      <bpmn:outgoing>c3</bpmn:outgoing>
      <bpmn:property id="verdicts" name="verdicts"/>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>subset.count</bpmn:loopCardinality>
        <bpmn:loopDataOutputRef>rows</bpmn:loopDataOutputRef>
        <bpmn:outputDataItem name="row"/>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartScored"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>

      <bpmn:serviceTask id="Score" name="Generate">
        <bpmn:extensionElements>
          <spiff:serviceTaskOperator id="generate" resultVariable="verdict">
            <spiff:parameters>
              <spiff:parameter id="prompt" value="&apos;Does this one theme appear in this one account?&apos;"/>
              <spiff:parameter id="of" value="subset"/>
              <spiff:parameter id="against" value="labels"/>
            </spiff:parameters>
          </spiff:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>s1</bpmn:incoming>
        <bpmn:outgoing>s2</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:loopCardinality>labels.length</bpmn:loopCardinality>
          <bpmn:loopDataOutputRef>verdicts</bpmn:loopDataOutputRef>
          <bpmn:outputDataItem name="verdict"/>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:serviceTask>

      <bpmn:serviceTask id="RowUp" name="Combine">
        <bpmn:extensionElements>
          <spiff:serviceTaskOperator id="combine" resultVariable="row">
            <spiff:parameters>
              <spiff:parameter id="how" value="&apos;one row of yes and no&apos;"/>
              <spiff:parameter id="parts" value="verdicts"/>
            </spiff:parameters>
          </spiff:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>s2</bpmn:incoming>
        <bpmn:outgoing>s3</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:endEvent id="EndScored"><bpmn:incoming>s3</bpmn:incoming></bpmn:endEvent>

      <bpmn:sequenceFlow id="s1" sourceRef="StartScored" targetRef="Score"/>
      <bpmn:sequenceFlow id="s2" sourceRef="Score" targetRef="RowUp"/>
      <bpmn:sequenceFlow id="s3" sourceRef="RowUp" targetRef="EndScored"/>
    </bpmn:subProcess>

    <bpmn:serviceTask id="Matrix" name="Combine">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="combine" resultVariable="themes">
          <spiff:parameters>
            <spiff:parameter id="how" value="&apos;stack the rows&apos;"/>
            <spiff:parameter id="parts" value="rows"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>c3</bpmn:incoming>
      <bpmn:outgoing>c4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="WithContext" name="Join">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="join" resultVariable="joined">
          <spiff:parameters>
            <spiff:parameter id="on" value="&apos;account identifier&apos;"/>
            <spiff:parameter id="parts" value="[themes, context]"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>c4</bpmn:incoming>
      <bpmn:outgoing>c5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Associate" name="Test">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="test" resultVariable="tested">
          <spiff:parameters>
            <spiff:parameter id="test" value="&apos;each theme against land cover, corrected for many tests&apos;"/>
            <spiff:parameter id="of" value="joined"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>c5</bpmn:incoming>
      <bpmn:outgoing>c6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Significant" name="Select">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="select" resultVariable="findings">
          <spiff:parameters>
            <spiff:parameter id="where" value="&apos;unlikely to be chance&apos;"/>
            <spiff:parameter id="of" value="tested"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>c6</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End"><bpmn:incoming>f13</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="Fork"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Fork" targetRef="ReadDocuments"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ReadDocuments" targetRef="PerDocument"/>
    <bpmn:sequenceFlow id="f_ctx" sourceRef="Fork" targetRef="ReadContext"/>
    <bpmn:sequenceFlow id="f4" sourceRef="PerDocument" targetRef="Pool"/>
    <bpmn:sequenceFlow id="f5" sourceRef="Pool" targetRef="EmbedEach"/>
    <bpmn:sequenceFlow id="f6" sourceRef="EmbedEach" targetRef="Refine"/>
    <bpmn:sequenceFlow id="f7" sourceRef="Refine" targetRef="NameGroups"/>
    <bpmn:sequenceFlow id="f8" sourceRef="NameGroups" targetRef="Merge"/>
    <bpmn:sequenceFlow id="f_ctx2" sourceRef="ReadContext" targetRef="Merge"/>
    <bpmn:sequenceFlow id="f10" sourceRef="Merge" targetRef="Subset"/>
    <bpmn:sequenceFlow id="c2" sourceRef="Subset" targetRef="PerScored"/>
    <bpmn:sequenceFlow id="c3" sourceRef="PerScored" targetRef="Matrix"/>
    <bpmn:sequenceFlow id="c4" sourceRef="Matrix" targetRef="WithContext"/>
    <bpmn:sequenceFlow id="c5" sourceRef="WithContext" targetRef="Associate"/>
    <bpmn:sequenceFlow id="c6" sourceRef="Associate" targetRef="Significant"/>
    <bpmn:sequenceFlow id="f13" sourceRef="Significant" targetRef="End"/>

    <bpmn:textAnnotation id="note1"><bpmn:text>Several readings of each account, so unsteady ones show up</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note1" sourceRef="PerDocument" targetRef="note1"/>
    <bpmn:textAnnotation id="note2"><bpmn:text>Near-identical wordings collapse into one shared vocabulary</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note2" sourceRef="Refine" targetRef="note2"/>
    <bpmn:textAnnotation id="note3"><bpmn:text>A person decides how similar counts as the same</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note3" sourceRef="Refine" targetRef="note3"/>
    <bpmn:textAnnotation id="note4"><bpmn:text>Where each account was recorded, gathered separately</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note4" sourceRef="ReadContext" targetRef="note4"/>
    <bpmn:textAnnotation id="note5"><bpmn:text>One account per participant, so the samples stay independent</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note5" sourceRef="Subset" targetRef="note5"/>
    <bpmn:textAnnotation id="note6"><bpmn:text>One judgement at a time: this theme, this account</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note6" sourceRef="PerScored" targetRef="note6"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Process_Pipeline">

      <bpmndi:BPMNShape id="s_Start" bpmnElement="Start">
        <dc:Bounds x="140" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_ReadDocuments" bpmnElement="ReadDocuments">
        <dc:Bounds x="280" y="210" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Fork" bpmnElement="Fork">
        <dc:Bounds x="200" y="225" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="s_PerDocument" bpmnElement="PerDocument" isExpanded="true">
        <dc:Bounds x="450" y="120" width="640" height="320"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_StartDocument" bpmnElement="StartDocument">
        <dc:Bounds x="480" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_PerPass" bpmnElement="PerPass" isExpanded="true">
        <dc:Bounds x="545" y="160" width="440" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_StartPass" bpmnElement="StartPass">
        <dc:Bounds x="570" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Draft" bpmnElement="Draft">
        <dc:Bounds x="630" y="210" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_DraftFailed" bpmnElement="DraftFailed">
        <dc:Bounds x="712" y="272" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_BackOff" bpmnElement="BackOff">
        <dc:Bounds x="712" y="332" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Structure" bpmnElement="Structure">
        <dc:Bounds x="800" y="210" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_EndPass" bpmnElement="EndPass">
        <dc:Bounds x="930" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_EndDocument" bpmnElement="EndDocument">
        <dc:Bounds x="1020" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="s_Pool" bpmnElement="Pool">
        <dc:Bounds x="1180" y="210" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_EmbedEach" bpmnElement="EmbedEach">
        <dc:Bounds x="1180" y="520" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Refine" bpmnElement="Refine" isExpanded="true">
        <dc:Bounds x="560" y="470" width="600" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_StartRefine" bpmnElement="StartRefine">
        <dc:Bounds x="1110" y="532" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Similarity" bpmnElement="Similarity">
        <dc:Bounds x="970" y="510" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Threshold" bpmnElement="Threshold">
        <dc:Bounds x="810" y="510" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Cluster" bpmnElement="Cluster">
        <dc:Bounds x="650" y="510" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_EndRefine" bpmnElement="EndRefine">
        <dc:Bounds x="585" y="532" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_NameGroups" bpmnElement="NameGroups">
        <dc:Bounds x="400" y="520" width="110" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="s_ReadContext" bpmnElement="ReadContext">
        <dc:Bounds x="280" y="720" width="110" height="80"/>
      </bpmndi:BPMNShape>
