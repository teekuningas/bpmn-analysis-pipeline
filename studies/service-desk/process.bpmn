<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:spiff="http://spiffworkflow.org/bpmn/schema/1.0/core"
                  id="Definitions_Desk"
                  targetNamespace="https://github.com/teekuningas/bpmn-analysis-pipeline">

  <bpmn:process id="Process_Desk" name="Complaints and plan" isExecutable="true">

    <bpmn:property id="all_labels" name="all_labels"/>
    <bpmn:property id="agreed" name="agreed"/>
    <bpmn:property id="rows" name="rows"/>

    <bpmn:startEvent id="Start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>

    <bpmn:serviceTask id="ReadTickets" name="Read">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="read" resultVariable="tickets">
          <spiff:parameters>
            <spiff:parameter id="gives" value="&apos;collection[ticket]&apos;"/>
            <spiff:parameter id="source" value="&apos;tickets&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Sample" name="Select">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="select" resultVariable="sample">
          <spiff:parameters>
            <spiff:parameter id="of" value="tickets"/>
            <spiff:parameter id="gives" value="&apos;collection[ticket]&apos;"/>
            <spiff:parameter id="where" value="&apos;index &lt; sample_size&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:subProcess id="PerTicket" name="For each ticket">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>count(sample)</bpmn:loopCardinality>
        <bpmn:loopDataOutputRef>all_labels</bpmn:loopDataOutputRef>
        <bpmn:outputDataItem name="labels"/>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartTicket"><bpmn:outgoing>t1</bpmn:outgoing></bpmn:startEvent>

      <bpmn:serviceTask id="Label" name="Generate">
        <bpmn:extensionElements>
          <spiff:serviceTaskOperator id="generate" resultVariable="labels">
            <spiff:parameters>
              <spiff:parameter id="of" value="sample"/>
              <spiff:parameter id="gives" value="&apos;collection[theme]&apos;"/>
              <spiff:parameter id="prompt" value="&apos;Say what this person is complaining about. Write each complaint as one short label, one per line. No numbering and no explanation.&apos;"/>
            </spiff:parameters>
          </spiff:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>t1</bpmn:incoming>
        <bpmn:outgoing>t2</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:endEvent id="EndTicket"><bpmn:incoming>t2</bpmn:incoming></bpmn:endEvent>

      <bpmn:sequenceFlow id="t1" sourceRef="StartTicket" targetRef="Label"/>
      <bpmn:sequenceFlow id="t2" sourceRef="Label" targetRef="EndTicket"/>
    </bpmn:subProcess>

    <bpmn:serviceTask id="Pool" name="Combine">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="combine" resultVariable="pooled">
          <spiff:parameters>
            <spiff:parameter id="parts" value="all_labels"/>
            <spiff:parameter id="gives" value="&apos;collection[theme]&apos;"/>
            <spiff:parameter id="how" value="&apos;distinct&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:subProcess id="Consolidate" name="Agree on a vocabulary">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>count(pooled)</bpmn:loopCardinality>
        <bpmn:loopDataOutputRef>agreed</bpmn:loopDataOutputRef>
        <bpmn:outputDataItem name="canonical"/>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartCons"><bpmn:outgoing>c1</bpmn:outgoing></bpmn:startEvent>

      <bpmn:serviceTask id="Canonicalise" name="Generate">
        <bpmn:extensionElements>
          <spiff:serviceTaskOperator id="generate" resultVariable="canonical">
            <spiff:parameters>
              <spiff:parameter id="of" value="[pooled, agreed]"/>
              <spiff:parameter id="labels" value="&apos;NEW LABEL|AGREED SO FAR&apos;"/>
              <spiff:parameter id="gives" value="&apos;theme&apos;"/>
              <spiff:parameter id="prompt" value="&apos;If the new label means the same as one of the labels agreed so far, reply with that agreed label copied exactly. Otherwise reply with the new label, tidied. Reply with one label and nothing else.&apos;"/>
            </spiff:parameters>
          </spiff:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>c1</bpmn:incoming>
        <bpmn:outgoing>c2</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:endEvent id="EndCons"><bpmn:incoming>c2</bpmn:incoming></bpmn:endEvent>

      <bpmn:sequenceFlow id="c1" sourceRef="StartCons" targetRef="Canonicalise"/>
      <bpmn:sequenceFlow id="c2" sourceRef="Canonicalise" targetRef="EndCons"/>
    </bpmn:subProcess>

    <bpmn:serviceTask id="Vocabulary" name="Combine">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="combine" resultVariable="themes">
          <spiff:parameters>
            <spiff:parameter id="parts" value="agreed"/>
            <spiff:parameter id="gives" value="&apos;collection[theme]&apos;"/>
            <spiff:parameter id="how" value="&apos;distinct&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ReadPlans" name="Read">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="read" resultVariable="plans">
          <spiff:parameters>
            <spiff:parameter id="gives" value="&apos;collection[plan]&apos;"/>
            <spiff:parameter id="source" value="&apos;plans&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:subProcess id="PerScored" name="For each ticket">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:property id="verdicts" name="verdicts"/>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>count(sample)</bpmn:loopCardinality>
        <bpmn:loopDataOutputRef>rows</bpmn:loopDataOutputRef>
        <bpmn:outputDataItem name="row"/>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartScored"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>

      <bpmn:serviceTask id="Score" name="Generate">
        <bpmn:extensionElements>
          <spiff:serviceTaskOperator id="generate" resultVariable="verdict">
            <spiff:parameters>
              <spiff:parameter id="of" value="[sample, themes]"/>
              <spiff:parameter id="labels" value="&apos;TICKET|COMPLAINT&apos;"/>
              <spiff:parameter id="gives" value="&apos;verdict&apos;"/>
              <spiff:parameter id="prompt" value="&apos;Is this the complaint being made in this ticket? Answer YES or NO, then one short sentence saying why.&apos;"/>
            </spiff:parameters>
          </spiff:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>s1</bpmn:incoming>
        <bpmn:outgoing>s2</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:loopCardinality>count(themes)</bpmn:loopCardinality>
          <bpmn:loopDataOutputRef>verdicts</bpmn:loopDataOutputRef>
          <bpmn:outputDataItem name="verdict"/>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:serviceTask>

      <bpmn:serviceTask id="RowUp" name="Combine">
        <bpmn:extensionElements>
          <spiff:serviceTaskOperator id="combine" resultVariable="row">
            <spiff:parameters>
              <spiff:parameter id="parts" value="verdicts"/>
              <spiff:parameter id="with" value="sample"/>
              <spiff:parameter id="gives" value="&apos;row&apos;"/>
              <spiff:parameter id="how" value="&apos;row&apos;"/>
            </spiff:parameters>
          </spiff:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>s2</bpmn:incoming>
        <bpmn:outgoing>s3</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:endEvent id="EndScored"><bpmn:incoming>s3</bpmn:incoming></bpmn:endEvent>

      <bpmn:sequenceFlow id="s1" sourceRef="StartScored" targetRef="Score"/>
      <bpmn:sequenceFlow id="s2" sourceRef="Score" targetRef="RowUp"/>
      <bpmn:sequenceFlow id="s3" sourceRef="RowUp" targetRef="EndScored"/>
    </bpmn:subProcess>

    <bpmn:serviceTask id="WithPlan" name="Join">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="join" resultVariable="joined">
          <spiff:parameters>
            <spiff:parameter id="left" value="rows"/>
            <spiff:parameter id="right" value="plans"/>
            <spiff:parameter id="gives" value="&apos;collection[pair[row, plan]]&apos;"/>
            <spiff:parameter id="on" value="&apos;id&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Associate" name="Test">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="test" resultVariable="tested">
          <spiff:parameters>
            <spiff:parameter id="of" value="joined"/>
            <spiff:parameter id="gives" value="&apos;collection[finding]&apos;"/>
            <spiff:parameter id="by" value="&apos;plan&apos;"/>
            <spiff:parameter id="test" value="&apos;each complaint against the plan, corrected for many tests&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Significant" name="Select">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="select" resultVariable="findings">
          <spiff:parameters>
            <spiff:parameter id="of" value="tested"/>
            <spiff:parameter id="gives" value="&apos;collection[finding]&apos;"/>
            <spiff:parameter id="where" value="&apos;item.q &lt; 0.05&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="ReadTickets"/>
    <bpmn:sequenceFlow id="f2" sourceRef="ReadTickets" targetRef="Sample"/>
    <bpmn:sequenceFlow id="f3" sourceRef="Sample" targetRef="PerTicket"/>
    <bpmn:sequenceFlow id="f4" sourceRef="PerTicket" targetRef="Pool"/>
    <bpmn:sequenceFlow id="f5" sourceRef="Pool" targetRef="Consolidate"/>
    <bpmn:sequenceFlow id="f6" sourceRef="Consolidate" targetRef="Vocabulary"/>
    <bpmn:sequenceFlow id="f7" sourceRef="Vocabulary" targetRef="ReadPlans"/>
    <bpmn:sequenceFlow id="f8" sourceRef="ReadPlans" targetRef="PerScored"/>
    <bpmn:sequenceFlow id="f9" sourceRef="PerScored" targetRef="WithPlan"/>
    <bpmn:sequenceFlow id="f10" sourceRef="WithPlan" targetRef="Associate"/>
    <bpmn:sequenceFlow id="f11" sourceRef="Associate" targetRef="Significant"/>
    <bpmn:sequenceFlow id="f12" sourceRef="Significant" targetRef="End"/>

    <bpmn:textAnnotation id="note1"><bpmn:text>One reading each — enough when the texts are this short</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note1" sourceRef="PerTicket" targetRef="note1"/>
    <bpmn:textAnnotation id="note2"><bpmn:text>The vocabulary grows as labels arrive; a label that matches an agreed one joins it</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note2" sourceRef="Consolidate" targetRef="note2"/>
    <bpmn:textAnnotation id="note3"><bpmn:text>Tickets with no plan on record drop out here</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note3" sourceRef="WithPlan" targetRef="note3"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Process_Desk">

      <bpmndi:BPMNShape id="s_Start" bpmnElement="Start">
        <dc:Bounds x="140" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_ReadTickets" bpmnElement="ReadTickets">
        <dc:Bounds x="200" y="210" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Sample" bpmnElement="Sample">
        <dc:Bounds x="340" y="210" width="110" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="s_PerTicket" bpmnElement="PerTicket" isExpanded="true">
        <dc:Bounds x="490" y="170" width="320" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_StartTicket" bpmnElement="StartTicket">
        <dc:Bounds x="515" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Label" bpmnElement="Label">
        <dc:Bounds x="580" y="210" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_EndTicket" bpmnElement="EndTicket">
        <dc:Bounds x="730" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="s_Pool" bpmnElement="Pool">
        <dc:Bounds x="870" y="210" width="110" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="s_Consolidate" bpmnElement="Consolidate" isExpanded="true">
        <dc:Bounds x="700" y="480" width="290" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_StartCons" bpmnElement="StartCons">
        <dc:Bounds x="926" y="542" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Canonicalise" bpmnElement="Canonicalise">
        <dc:Bounds x="790" y="520" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_EndCons" bpmnElement="EndCons">
        <dc:Bounds x="730" y="542" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="s_Vocabulary" bpmnElement="Vocabulary">
        <dc:Bounds x="530" y="520" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_ReadPlans" bpmnElement="ReadPlans">
        <dc:Bounds x="200" y="760" width="110" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="s_PerScored" bpmnElement="PerScored" isExpanded="true">
        <dc:Bounds x="380" y="880" width="420" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_StartScored" bpmnElement="StartScored">
        <dc:Bounds x="405" y="962" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Score" bpmnElement="Score">
        <dc:Bounds x="470" y="920" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_RowUp" bpmnElement="RowUp">
        <dc:Bounds x="610" y="920" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_EndScored" bpmnElement="EndScored">
        <dc:Bounds x="745" y="962" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="s_WithPlan" bpmnElement="WithPlan">
        <dc:Bounds x="850" y="920" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Associate" bpmnElement="Associate">
        <dc:Bounds x="990" y="920" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Significant" bpmnElement="Significant">
        <dc:Bounds x="1130" y="920" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_End" bpmnElement="End">
        <dc:Bounds x="1270" y="942" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="s_note1" bpmnElement="note1">
        <dc:Bounds x="490" y="80" width="300" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_note2" bpmnElement="note2">
        <dc:Bounds x="1030" y="480" width="300" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_note3" bpmnElement="note3">
        <dc:Bounds x="850" y="1030" width="300" height="56"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="e_f1" bpmnElement="f1">
        <di:waypoint x="176" y="250"/><di:waypoint x="200" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f2" bpmnElement="f2">
        <di:waypoint x="310" y="250"/><di:waypoint x="340" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f3" bpmnElement="f3">
        <di:waypoint x="450" y="250"/><di:waypoint x="490" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_t1" bpmnElement="t1">
        <di:waypoint x="551" y="250"/><di:waypoint x="580" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_t2" bpmnElement="t2">
        <di:waypoint x="690" y="250"/><di:waypoint x="730" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f4" bpmnElement="f4">
        <di:waypoint x="810" y="250"/><di:waypoint x="870" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f5" bpmnElement="f5">
        <di:waypoint x="925" y="290"/><di:waypoint x="925" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_c1" bpmnElement="c1">
        <di:waypoint x="926" y="560"/><di:waypoint x="900" y="560"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_c2" bpmnElement="c2">
        <di:waypoint x="790" y="560"/><di:waypoint x="766" y="560"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f6" bpmnElement="f6">
        <di:waypoint x="700" y="560"/><di:waypoint x="640" y="560"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f7" bpmnElement="f7">
        <di:waypoint x="585" y="600"/><di:waypoint x="585" y="700"/>
        <di:waypoint x="255" y="700"/><di:waypoint x="255" y="760"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f8" bpmnElement="f8">
        <di:waypoint x="255" y="840"/><di:waypoint x="255" y="980"/>
        <di:waypoint x="380" y="980"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_s1" bpmnElement="s1">
        <di:waypoint x="441" y="960"/><di:waypoint x="470" y="960"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_s2" bpmnElement="s2">
        <di:waypoint x="580" y="960"/><di:waypoint x="610" y="960"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_s3" bpmnElement="s3">
        <di:waypoint x="720" y="960"/><di:waypoint x="745" y="960"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f9" bpmnElement="f9">
        <di:waypoint x="800" y="960"/><di:waypoint x="850" y="960"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f10" bpmnElement="f10">
        <di:waypoint x="960" y="960"/><di:waypoint x="990" y="960"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f11" bpmnElement="f11">
        <di:waypoint x="1100" y="960"/><di:waypoint x="1130" y="960"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f12" bpmnElement="f12">
        <di:waypoint x="1240" y="960"/><di:waypoint x="1270" y="960"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="e_a_note1" bpmnElement="a_note1">
        <di:waypoint x="640" y="170"/><di:waypoint x="640" y="136"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_a_note2" bpmnElement="a_note2">
        <di:waypoint x="990" y="515"/><di:waypoint x="1030" y="515"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_a_note3" bpmnElement="a_note3">
        <di:waypoint x="905" y="1000"/><di:waypoint x="905" y="1030"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
