<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:spiff="http://spiffworkflow.org/bpmn/schema/1.0/core"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Nature"
                  targetNamespace="https://github.com/teekuningas/bpmn-analysis-pipeline">

  <bpmn:process id="Process_Nature" name="Themes and place" isExecutable="true">

    <bpmn:property id="all_readings" name="all_readings"/>
    <bpmn:property id="places" name="places"/>
    <bpmn:property id="judgements" name="judgements"/>
    <bpmn:property id="rows" name="rows"/>

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:parallelGateway id="Fork">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="ReadAccounts" name="Read">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="read" resultVariable="accounts">
          <spiff:parameters>
            <spiff:parameter id="gives" value="&apos;collection[account]&apos;"/>
            <spiff:parameter id="source" value="&apos;accounts&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Sample" name="Select">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="select" resultVariable="sample">
          <spiff:parameters>
            <spiff:parameter id="of" value="accounts"/>
            <spiff:parameter id="gives" value="&apos;collection[account]&apos;"/>
            <spiff:parameter id="where" value="&apos;index &lt; sample_size&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f3b</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:subProcess id="PerAccount" name="For each account">
      <bpmn:incoming>f3b</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:property id="readings" name="readings"/>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>count(sample)</bpmn:loopCardinality>
        <bpmn:loopDataOutputRef>all_readings</bpmn:loopDataOutputRef>
        <bpmn:outputDataItem name="readings"/>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartAccount"><bpmn:outgoing>d1</bpmn:outgoing></bpmn:startEvent>

      <bpmn:subProcess id="PerPass" name="For each pass">
        <bpmn:incoming>d1</bpmn:incoming>
        <bpmn:outgoing>d2</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:loopCardinality>2</bpmn:loopCardinality>
          <bpmn:loopDataOutputRef>readings</bpmn:loopDataOutputRef>
          <bpmn:outputDataItem name="codebook"/>
        </bpmn:multiInstanceLoopCharacteristics>

        <bpmn:startEvent id="StartPass"><bpmn:outgoing>p1</bpmn:outgoing></bpmn:startEvent>

        <bpmn:serviceTask id="Draft" name="Generate">
          <bpmn:extensionElements>
            <spiff:serviceTaskOperator id="generate" resultVariable="draft">
              <spiff:parameters>
                <spiff:parameter id="of" value="sample"/>
                <spiff:parameter id="gives" value="&apos;draft&apos;"/>
                <spiff:parameter id="prompt" value="&apos;Read this account and say in a few sentences what it is about. Name the themes you find in it.&apos;"/>
                <spiff:parameter id="seed" value="index"/>
              </spiff:parameters>
            </spiff:serviceTaskOperator>
          </bpmn:extensionElements>
          <bpmn:incoming>p1</bpmn:incoming>
          <bpmn:incoming>p_retry</bpmn:incoming>
          <bpmn:outgoing>p2</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:boundaryEvent id="DraftFailed" attachedToRef="Draft" retries="3">
          <bpmn:errorEventDefinition/>
          <bpmn:outgoing>p_backoff</bpmn:outgoing>
        </bpmn:boundaryEvent>

        <bpmn:intermediateCatchEvent id="BackOff">
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration>PT0.5S</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
          <bpmn:incoming>p_backoff</bpmn:incoming>
          <bpmn:outgoing>p_retry</bpmn:outgoing>
        </bpmn:intermediateCatchEvent>

        <bpmn:serviceTask id="Structure" name="Generate">
          <bpmn:extensionElements>
            <spiff:serviceTaskOperator id="generate" resultVariable="codebook">
              <spiff:parameters>
                <spiff:parameter id="of" value="draft"/>
                <spiff:parameter id="gives" value="&apos;collection[theme]&apos;"/>
                <spiff:parameter id="prompt" value="&apos;Write each theme in this reading as one short label, one per line. No numbering and no explanation.&apos;"/>
              </spiff:parameters>
            </spiff:serviceTaskOperator>
          </bpmn:extensionElements>
          <bpmn:incoming>p2</bpmn:incoming>
          <bpmn:outgoing>p3</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:endEvent id="EndPass"><bpmn:incoming>p3</bpmn:incoming></bpmn:endEvent>

        <bpmn:sequenceFlow id="p1" sourceRef="StartPass" targetRef="Draft"/>
        <bpmn:sequenceFlow id="p_backoff" sourceRef="DraftFailed" targetRef="BackOff"/>
        <bpmn:sequenceFlow id="p_retry" sourceRef="BackOff" targetRef="Draft"/>
        <bpmn:sequenceFlow id="p2" sourceRef="Draft" targetRef="Structure"/>
        <bpmn:sequenceFlow id="p3" sourceRef="Structure" targetRef="EndPass"/>
      </bpmn:subProcess>

      <bpmn:endEvent id="EndAccount"><bpmn:incoming>d2</bpmn:incoming></bpmn:endEvent>

      <bpmn:sequenceFlow id="d1" sourceRef="StartAccount" targetRef="PerPass"/>
      <bpmn:sequenceFlow id="d2" sourceRef="PerPass" targetRef="EndAccount"/>
    </bpmn:subProcess>

    <bpmn:serviceTask id="Pool" name="Combine">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="combine" resultVariable="pooled">
          <spiff:parameters>
            <spiff:parameter id="parts" value="all_readings"/>
            <spiff:parameter id="gives" value="&apos;collection[theme]&apos;"/>
            <spiff:parameter id="how" value="&apos;distinct&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:subProcess id="PerTheme" name="For each theme">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:incoming>f_back</bpmn:incoming>
      <bpmn:outgoing>f5b</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>count(pooled)</bpmn:loopCardinality>
        <bpmn:loopDataOutputRef>places</bpmn:loopDataOutputRef>
        <bpmn:outputDataItem name="place"/>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartPlace"><bpmn:outgoing>e1</bpmn:outgoing></bpmn:startEvent>

      <bpmn:serviceTask id="Place" name="Embed">
        <bpmn:extensionElements>
          <spiff:serviceTaskOperator id="embed" resultVariable="place">
            <spiff:parameters>
              <spiff:parameter id="of" value="pooled"/>
              <spiff:parameter id="gives" value="&apos;vector&apos;"/>
            </spiff:parameters>
          </spiff:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>e1</bpmn:incoming>
        <bpmn:outgoing>e2</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:endEvent id="EndPlace"><bpmn:incoming>e2</bpmn:incoming></bpmn:endEvent>

      <bpmn:sequenceFlow id="e1" sourceRef="StartPlace" targetRef="Place"/>
      <bpmn:sequenceFlow id="e2" sourceRef="Place" targetRef="EndPlace"/>
    </bpmn:subProcess>

    <bpmn:serviceTask id="Nearest" name="Combine">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="combine" resultVariable="candidates">
          <spiff:parameters>
            <spiff:parameter id="parts" value="places"/>
            <spiff:parameter id="with" value="pooled"/>
            <spiff:parameter id="gives" value="&apos;collection[pair[theme, theme]]&apos;"/>
            <spiff:parameter id="how" value="&apos;nearest&apos;"/>
            <spiff:parameter id="by" value="pairs_per_round"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f5b</bpmn:incoming>
      <bpmn:outgoing>f5c</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:subProcess id="PerPair" name="Until one merges">
      <bpmn:incoming>f5c</bpmn:incoming>
      <bpmn:outgoing>f5d</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>count(candidates)</bpmn:loopCardinality>
        <bpmn:loopDataOutputRef>judgements</bpmn:loopDataOutputRef>
        <bpmn:outputDataItem name="judgement"/>
        <bpmn:completionCondition>judgement.same</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartPair"><bpmn:outgoing>j1</bpmn:outgoing></bpmn:startEvent>

      <bpmn:serviceTask id="Judge" name="Generate">
        <bpmn:extensionElements>
          <spiff:serviceTaskOperator id="generate" resultVariable="judgement">
            <spiff:parameters>
              <spiff:parameter id="of" value="candidates"/>
              <spiff:parameter id="labels" value="&apos;THEME A|THEME B&apos;"/>
              <spiff:parameter id="gives" value="&apos;judgement&apos;"/>
              <spiff:parameter id="prompt" value="&apos;Are these two the same concept? Say no if either is broader than the other, or names a different side of the same subject. If they are the same, give the clearer of the two wordings.&apos;"/>
            </spiff:parameters>
          </spiff:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>j1</bpmn:incoming>
        <bpmn:outgoing>j2</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:endEvent id="EndPair"><bpmn:incoming>j2</bpmn:incoming></bpmn:endEvent>

      <bpmn:sequenceFlow id="j1" sourceRef="StartPair" targetRef="Judge"/>
      <bpmn:sequenceFlow id="j2" sourceRef="Judge" targetRef="EndPair"/>
    </bpmn:subProcess>

    <bpmn:serviceTask id="Settle" name="Combine">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="combine" resultVariable="pooled">
          <spiff:parameters>
            <spiff:parameter id="parts" value="judgements"/>
            <spiff:parameter id="with" value="pooled"/>
            <spiff:parameter id="gives" value="&apos;collection[theme]&apos;"/>
            <spiff:parameter id="how" value="&apos;merge&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f5d</bpmn:incoming>
      <bpmn:outgoing>f5e</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Converged" name="did one merge?" default="f6">
      <bpmn:incoming>f5e</bpmn:incoming>
      <bpmn:outgoing>f_back</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Vocabulary" name="Combine">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="combine" resultVariable="themes">
          <spiff:parameters>
            <spiff:parameter id="parts" value="pooled"/>
            <spiff:parameter id="gives" value="&apos;collection[theme]&apos;"/>
            <spiff:parameter id="how" value="&apos;distinct&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f6b</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ReadSites" name="Read">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="read" resultVariable="sites">
          <spiff:parameters>
            <spiff:parameter id="gives" value="&apos;collection[site]&apos;"/>
            <spiff:parameter id="source" value="&apos;sites&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Merge">
      <bpmn:incoming>f6b</bpmn:incoming>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:subProcess id="PerScored" name="For each account">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:property id="verdicts" name="verdicts"/>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>count(sample)</bpmn:loopCardinality>
        <bpmn:loopDataOutputRef>rows</bpmn:loopDataOutputRef>
        <bpmn:outputDataItem name="row"/>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartScored"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>

      <bpmn:serviceTask id="Score" name="Generate">
        <bpmn:extensionElements>
          <spiff:serviceTaskOperator id="generate" resultVariable="verdict">
            <spiff:parameters>
              <spiff:parameter id="of" value="[sample, themes]"/>
              <spiff:parameter id="labels" value="&apos;ACCOUNT|THEME&apos;"/>
              <spiff:parameter id="gives" value="&apos;verdict&apos;"/>
              <spiff:parameter id="prompt" value="&apos;Does this theme appear in this account? Answer YES or NO, then one short sentence saying why.&apos;"/>
            </spiff:parameters>
          </spiff:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>s1</bpmn:incoming>
        <bpmn:outgoing>s2</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:loopCardinality>count(themes)</bpmn:loopCardinality>
          <bpmn:loopDataOutputRef>verdicts</bpmn:loopDataOutputRef>
          <bpmn:outputDataItem name="verdict"/>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:serviceTask>

      <bpmn:serviceTask id="RowUp" name="Combine">
        <bpmn:extensionElements>
          <spiff:serviceTaskOperator id="combine" resultVariable="row">
            <spiff:parameters>
              <spiff:parameter id="parts" value="verdicts"/>
              <spiff:parameter id="with" value="sample"/>
              <spiff:parameter id="gives" value="&apos;row&apos;"/>
              <spiff:parameter id="how" value="&apos;row&apos;"/>
            </spiff:parameters>
          </spiff:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>s2</bpmn:incoming>
        <bpmn:outgoing>s3</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:endEvent id="EndScored"><bpmn:incoming>s3</bpmn:incoming></bpmn:endEvent>

      <bpmn:sequenceFlow id="s1" sourceRef="StartScored" targetRef="Score"/>
      <bpmn:sequenceFlow id="s2" sourceRef="Score" targetRef="RowUp"/>
      <bpmn:sequenceFlow id="s3" sourceRef="RowUp" targetRef="EndScored"/>
    </bpmn:subProcess>

    <bpmn:serviceTask id="WithContext" name="Join">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="join" resultVariable="joined">
          <spiff:parameters>
            <spiff:parameter id="left" value="rows"/>
            <spiff:parameter id="right" value="sites"/>
            <spiff:parameter id="gives" value="&apos;collection[pair[row, site]]&apos;"/>
            <spiff:parameter id="on" value="&apos;id&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Associate" name="Test">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="test" resultVariable="tested">
          <spiff:parameters>
            <spiff:parameter id="of" value="joined"/>
            <spiff:parameter id="gives" value="&apos;collection[finding]&apos;"/>
            <spiff:parameter id="by" value="&apos;setting&apos;"/>
            <spiff:parameter id="test" value="&apos;each theme against the setting, corrected for many tests&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Significant" name="Select">
      <bpmn:extensionElements>
        <spiff:serviceTaskOperator id="select" resultVariable="findings">
          <spiff:parameters>
            <spiff:parameter id="of" value="tested"/>
            <spiff:parameter id="gives" value="&apos;collection[finding]&apos;"/>
            <spiff:parameter id="where" value="&apos;item.q &lt; 0.05&apos;"/>
          </spiff:parameters>
        </spiff:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End"><bpmn:incoming>f14</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="Fork"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Fork" targetRef="ReadAccounts"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ReadAccounts" targetRef="Sample"/>
    <bpmn:sequenceFlow id="f3b" sourceRef="Sample" targetRef="PerAccount"/>
    <bpmn:sequenceFlow id="f4" sourceRef="PerAccount" targetRef="Pool"/>
    <bpmn:sequenceFlow id="f5" sourceRef="Pool" targetRef="PerTheme"/>
    <bpmn:sequenceFlow id="f5b" sourceRef="PerTheme" targetRef="Nearest"/>
    <bpmn:sequenceFlow id="f5c" sourceRef="Nearest" targetRef="PerPair"/>
    <bpmn:sequenceFlow id="f5d" sourceRef="PerPair" targetRef="Settle"/>
    <bpmn:sequenceFlow id="f5e" sourceRef="Settle" targetRef="Converged"/>
    <bpmn:sequenceFlow id="f_back" sourceRef="Converged" targetRef="PerTheme">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">judgements.length &gt; 0 &amp;&amp; judgements[judgements.length - 1].same</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f6" sourceRef="Converged" targetRef="Vocabulary"/>
    <bpmn:sequenceFlow id="f6b" sourceRef="Vocabulary" targetRef="Merge"/>
    <bpmn:sequenceFlow id="f7" sourceRef="Fork" targetRef="ReadSites"/>
    <bpmn:sequenceFlow id="f8" sourceRef="ReadSites" targetRef="Merge"/>
    <bpmn:sequenceFlow id="f9" sourceRef="Merge" targetRef="PerScored"/>
    <bpmn:sequenceFlow id="f11" sourceRef="PerScored" targetRef="WithContext"/>
    <bpmn:sequenceFlow id="f12" sourceRef="WithContext" targetRef="Associate"/>
    <bpmn:sequenceFlow id="f13" sourceRef="Associate" targetRef="Significant"/>
    <bpmn:sequenceFlow id="f14" sourceRef="Significant" targetRef="End"/>

    <bpmn:textAnnotation id="note1"><bpmn:text>Each account is read twice, so unsteady themes show up</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note1" sourceRef="PerAccount" targetRef="note1"/>
    <bpmn:textAnnotation id="note3"><bpmn:text>A short run reads the first few accounts; the whole set takes much longer</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note3" sourceRef="Sample" targetRef="note3"/>
    <bpmn:textAnnotation id="note2"><bpmn:text>Only the most promising pairs are asked about. Embedding ranks them; it never decides</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note2" sourceRef="Nearest" targetRef="note2"/>
    <bpmn:textAnnotation id="note4"><bpmn:text>Where each account was recorded, gathered separately</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note4" sourceRef="ReadSites" targetRef="note4"/>
    <bpmn:textAnnotation id="note5"><bpmn:text>One judgement at a time: this theme, this account</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note5" sourceRef="PerScored" targetRef="note5"/>
    <bpmn:textAnnotation id="note7"><bpmn:text>One merge, then start over with fresh pairs. A round where none of them merge is the end of it</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note7" sourceRef="Converged" targetRef="note7"/>
    <bpmn:textAnnotation id="note6"><bpmn:text>Accounts with no site record drop out here</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a_note6" sourceRef="WithContext" targetRef="note6"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Process_Nature">

      <bpmndi:BPMNShape id="s_Start" bpmnElement="Start">
        <dc:Bounds x="140" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Fork" bpmnElement="Fork">
        <dc:Bounds x="200" y="225" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_ReadAccounts" bpmnElement="ReadAccounts">
        <dc:Bounds x="280" y="210" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Sample" bpmnElement="Sample">
        <dc:Bounds x="420" y="210" width="110" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="s_PerAccount" bpmnElement="PerAccount" isExpanded="true">
        <dc:Bounds x="570" y="120" width="640" height="320"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_StartAccount" bpmnElement="StartAccount">
        <dc:Bounds x="600" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_PerPass" bpmnElement="PerPass" isExpanded="true">
        <dc:Bounds x="665" y="160" width="440" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_StartPass" bpmnElement="StartPass">
        <dc:Bounds x="690" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Draft" bpmnElement="Draft">
